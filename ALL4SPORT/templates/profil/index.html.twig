{% extends 'base.html.twig' %}

{% block title %}profil{% endblock %}

{% block body %}
<main class="product-page product-list-page">
    <a href="{{ path('app_accueil') }}">&larr; Retour accueil</a>

<h1>Votre profil</h1>

    <div class="product-table-wrap">
        <table class="product-table">
            <thead>
                <tr>
                    <th>email</th>
                    <th>nom</th>
                    <th>prenom</th>
                    <th>adresse</th>
                    <th>telephone</th>
                    <th>date_naissance</th>
                </tr>
            </thead>
            <tbody>
                {% if app.user %}
                    <tr>
                        <td>{{ app.user.email }}</td>
                        <td>{{ app.user.nom }}</td>
                        <td>{{ app.user.prenom }}</td>
                        <td>{{ app.user.adresse }}</td>
                        <td>{{ app.user.telephone }}</td>
                        <td>{{ app.user.dateNaissance ? app.user.dateNaissance|date('Y-m-d') : '' }}</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
{% endblock %}
