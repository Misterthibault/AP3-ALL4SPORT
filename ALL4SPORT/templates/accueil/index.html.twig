{% extends 'base.html.twig' %}

{% block title %}ALL 4 SPORT{% endblock %}

{% block body %}
<header class="site-header">
    <nav class="header-actions" aria-label="Navigation principale">
        {% if app.user %}
            <a class="button button-danger" href="{{ path('app_logout') }}">Déconnecter</a>
        {% else %}
            <a class="button button-primary" href="{{ path('app_register') }}">S'enregistrer</a>
            <a class="button button-secondary" href="{{ path('app_login') }}">Se connecter</a>
        {% endif %}

        <a class="button button-cart" href="{{ path('app_panier') }}">Panier</a>
    </nav>
</header>

<style>
    .site-header {
        padding: 1rem 2rem;
        background: #5c626e;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.18);
    }

    .header-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.75rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0.65rem 1.2rem;
        border: 2px solid transparent;
        border-radius: 999px;
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.22);
    }

    .button:focus-visible {
        outline: 3px solid #f9d74a;
        outline-offset: 3px;
    }

    .button-primary {
        background: #ffffff;
        border-color: #ffffff;
        color: #0b5fff;
    }

    .button-secondary {
        background: #16a34a;
    }

    .button-danger {
        background: #dc2626;
    }

    .button-cart {
        background: #111827;
    }

    .example-wrapper {
        margin: 2rem auto;
        max-width: 850px;
        width: 95%;
        padding: 3rem;
        text-align: center;
        background: linear-gradient(145deg, #ffffff, #f2f7ff);
        border: 1px solid #dce7f5;
        border-radius: 20px;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.12);
        font-family: Arial, sans-serif;
        color: #172033;
    }

    .example-wrapper h1 {
        margin: 0 0 1rem;
        color: #0b5fff;
        font-size: 2.5rem;
        line-height: 1.2;
    }

    .example-wrapper p {
        margin: 0.8rem 0;
        font-size: 1.15rem;
        line-height: 1.6;
    }

    .example-wrapper p:last-child {
        color: #4b5563;
        font-weight: 600;
    }
</style>

<div class="example-wrapper">
    <h1>Hello
        {% if app.user %}
            {{ app.user.nom }} {{ app.user.prenom }}!
        {% else %}
            <p>nouvel utilisateur</p>
        {% endif %}
    </h1>

    <p>Venez acheter vos articles de sport sur notre site ALL 4 SPORT !</p>
    <p>pas chere pas chere</p>
</div>
{% endblock %}
