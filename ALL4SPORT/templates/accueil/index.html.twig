{% extends 'base.html.twig' %}

{% block title %}ALL 4 SPORT{% endblock %}

{% block body %}

<div class="example-wrapper">
    <h1>Hello
        {% if app.user %}
            {{ app.user.nom }} {{ app.user.prenom }} !
        {% else %}
            <p>nouvel utilisateur</p>
        {% endif %}
    </h1>

    <p>Venez acheter vos produits de sport sur notre site ALL 4 SPORT !</p>
    <p id="easter-egg">pas chere pas chere</p>
</div>


<section class="products-section" aria-label="Produits disponibles">
    <div class="container-produit">
        {% for produit in produits %}
            <article class="product-card">
                {% if produit.imageFilename %}
                    <img class="product-image" src="{{ asset('uploads/products/' ~ produit.imageFilename) }}" alt="{{ produit.nom }}">
                {% endif %}
                <p style="font-weight: bold; font-size: 25px;color: #2474B5 !important;">{{ produit.nom }}</p>
                <p class="product-description">{{ produit.description }}</p>
                <p class="product-price">{{ produit.prixVente }} €</p>
                <a class="product-link" href="{{ path('produit_show', {'id': produit.id}) }}">
                    Voir le produit en détail
                </a>
            </article>
        {% else %}
            <p class="empty-products">Aucun produit n'est disponible pour le moment.</p>
        {% endfor %}
    </div>
</section>

<style>
    .products-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
        gap: 1.25rem;
        width: min(1100px, calc(100% - 2rem));
        margin: 2rem auto;
    }

    .product-card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        background: #ffffff;
        border: 1px solid #dce7f5;
        border-radius: 14px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.09);
        color: #172033;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.15);
    }

    .product-card h2 {
        margin: 0 0 0.75rem;
        color: #F86E00 ;
        font-size: 1.3rem;
    }

    .product-image {
        width: 100%;
        height: 200px;
        margin-bottom: 1rem;
        border-radius: 8px;
        object-fit: cover;
    }

    .product-description {
        flex: 1;
        margin: 0 0 1rem;
        color: #4b5563;
        line-height: 1.55;
    }

    .product-price {
        margin: 0 0 1rem;
        color: #F86E00;
        font-size: 1.25rem;
        font-weight: 700;
    }

    .product-link {
        align-self: flex-start;
        padding: 0.65rem 1rem;
        border-radius: 7px;
        background: #F86E00 ;
        color: #ffffff;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 0.2s ease;
    }

    .product-link:hover {
        background: #D15E00;
    }

    .product-link:focus-visible {
        outline: 3px solid #f9d74a;
        outline-offset: 3px;
    }

    .add-to-cart-button {
        display: inline-block;
        margin-top: 0.75rem;
        border: 0;
        cursor: pointer;
        font: inherit;
    }

    .empty-products {
        grid-column: 1 / -1;
        padding: 1.5rem;
        border-radius: 12px;
        background: #f2f7ff;
        color: #4b5563;
        text-align: center;
    }
</style>

{% endblock %}
