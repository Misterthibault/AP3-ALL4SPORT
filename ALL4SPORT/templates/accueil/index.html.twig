{% extends 'base.html.twig' %}

{% block title %}ALL 4 SPORT{% endblock %}

{% block body %}

<div class="example-wrapper">
    <h1>Hello
        {% if app.user %}
            {{ app.user.nom }} {{ app.user.prenom }}!
        {% else %}
            <p>nouvel utilisateur</p>
        {% endif %}
    </h1>

    <p>Venez acheter vos produits de sport sur notre site ALL 4 SPORT !</p>
    <p id="easter-egg">pas chere pas chere</p>
</div>


<section class="products-section" aria-label="Produits disponibles">
    {% for produit in produits %}
        <article class="product-card">
            <h2>{{ produit.nom }}</h2>
            <p class="product-description">{{ produit.description }}</p>
            <p class="product-price">{{ produit.prixVente }} €</p>
            <a class="product-link" href="{{ path('produit_show', {'id': produit.id}) }}">
                Voir le produit en détail
            </a>
        </article>
    {% else %}
        <p class="empty-products">Aucun produit n'est disponible pour le moment.</p>
    {% endfor %}
</section>

<style>
    .products-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
        gap: 1.25rem;
        width: min(1100px, calc(100% - 2rem));
        margin: 2rem auto;
    }

    .product-card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        background: #ffffff;
        border: 1px solid #dce7f5;
        border-radius: 14px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.09);
        color: #172033;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.15);
    }

    .product-card h2 {
        margin: 0 0 0.75rem;
        color: #0b5fff;
        font-size: 1.3rem;
    }

    .product-description {
        flex: 1;
        margin: 0 0 1rem;
        color: #4b5563;
        line-height: 1.55;
    }

    .product-price {
        margin: 0 0 1rem;
        color: #15803d;
        font-size: 1.25rem;
        font-weight: 700;
    }

    .product-link {
        align-self: flex-start;
        padding: 0.65rem 1rem;
        border-radius: 7px;
        background: #0b5fff;
        color: #ffffff;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 0.2s ease;
    }

    .product-link:hover {
        background: #0847c4;
    }

    .product-link:focus-visible {
        outline: 3px solid #f9d74a;
        outline-offset: 3px;
    }

    .empty-products {
        grid-column: 1 / -1;
        padding: 1.5rem;
        border-radius: 12px;
        background: #f2f7ff;
        color: #4b5563;
        text-align: center;
    }
</style>

{% endblock %}
