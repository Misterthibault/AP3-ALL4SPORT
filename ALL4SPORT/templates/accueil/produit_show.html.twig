{% extends 'base.html.twig' %}

{% block title %}Détail du produit{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">

    {% if produit.imageFilename %}
        <img class="product-image" src="{{ asset('uploads/products/' ~ produit.imageFilename) }}" alt="{{ produit.nom }}">
    {% endif %}
    <h2>{{ produit.nom }}</h2>
    <p>{{ produit.description }}</p>
    <p>{{ produit.prixVente }} €</p>  
    {% if is_granted('ROLE_USER') %}
        <form method="post" action="{{ path('app_panier_ajouter', {id: produit.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('panier_ajouter_' ~ produit.id) }}">
            <button type="submit">Ajouter au panier</button>
        </form>
    {% else %}
        <a href="{{ path('app_login') }}">Connectez-vous pour commander</a>
    {% endif %}
    <br>
    <a href="{{ path('app_accueil') }}"> Retourner à l'ecran d'accueil<a/>
    <hr>

</div>
{% endblock %}
