{% extends 'base.html.twig' %}

{% block title %}Produit index{% endblock %}

{% block body %}
<main class="product-page product-list-page">
    <h1>Nos produits</h1>

    <div class="product-table-wrap">
        <table class="product-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Référence</th>
                    <th>Prix de vente</th>
                    <th>Fournisseur</th>
                    <th>Description</th>
                    <th>Nom</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for produit in produits %}
                <tr>
                    <td>{{ produit.id }}</td>
                    <td>{{ produit.ref }}</td>
                    <td>{{ produit.prixVente }}</td>
                    <td>{{ produit.nomFournisseur }}</td>
                    <td>{{ produit.description }}</td>
                    <td>{{ produit.nom }}</td>
                    <td class="product-actions">
                        <a href="{{ path('app_produit_show', {'id': produit.id}) }}">Détails</a>
                        <a href="{{ path('app_produit_edit', {'id': produit.id}) }}">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="product-empty" colspan="7">Aucun produit pour le moment.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <a class="product-primary-link" href="{{ path('app_produit_new') }}">Ajouter un produit</a>
</main>
{% endblock %}
