{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    <a class="registration-link registration-link--login" href="{{ path('app_login') }}">Déjà inscrit ? Connectez-vous ici</a>
    <a class="registration-link registration-link--home" href="{{ path('app_accueil') }}">Retour à l'accueil</a>
    <h1>Enregistrez vous !</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.nom) }}
        {{ form_row(registrationForm.prenom) }}
        {{ form_row(registrationForm.date_naissance) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.telephone) }}
        {{ form_row(registrationForm.adresse) }}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Mot de passe'
        }) }}
        {{ form_row(registrationForm.agreeTerms) }}

        <button type="submit" class="btn">S'enregistrer</button>
    {{ form_end(registrationForm) }}
{% endblock %}
